    <string name="onb_welcome_no_trial_note">התקנת Claro אינה מתחילה תקופת ניסיון ואינה כרוכה בתשלום.</string>
    <string name="onb_welcome_tagline">האנשים הקרובים אליכם. בנגיעה אחת.</string>
    <string name="onb_welcome_subtitle">מסך בית, טלפון והודעות פשוטים וברורים יותר — להגדרה עצמית או יחד עם אדם קרוב.</string>
    <string name="onb_welcome_permissions_sos_note">Android מבקשת בנפרד גישה למסך הבית, לטלפון, ל-SMS ולמצלמה בעת הצורך. לחצן SOS מתקשר לאיש קשר אחד שבחרתם — זה אינו מוקד חירום מאויש.</string>


    <string name="onb_date_gate_instructions">הזינו את התאריך של היום במבנה dd/MM/YYYY. שלב זה מונע לחיצות אקראיות ואינו נעילת אבטחה.</string>
    <string name="onb_pin_gate_instructions">הזינו קוד בן 6 ספרות של בן משפחה או מלווה כדי לפתוח את ההגדרות.</string>
    <string name="onb_date_field_supporting">יום ב-2 ספרות, חודש ב-2 ספרות, שנה ב-4 ספרות</string>

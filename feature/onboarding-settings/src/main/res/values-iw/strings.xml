    <string name="onb_recover_pin_title">שחזור קוד PIN למלווה</string>
    <string name="onb_set_new_pin">קביעת קוד PIN חדש</string>
    <string name="onb_recover_pin_instructions">השתמשו בצופן השחזור שנשמר בעת ההגדרה. התאריך של היום אינו יכול לעקוף או לאפס קוד PIN למלווה.</string>
    <string name="onb_recovery_secret_label">צופן שחזור</string>
    <string name="onb_new_six_digit_pin_label">קוד PIN חדש בן 6 ספרות</string>
    <string name="onb_confirm_new_pin_label">אימות קוד PIN חדש</string>
    <string name="onb_recover_pin_lost_both_warning">איבדתם גם את קוד ה-PIN וגם את צופן השחזור? אפסו את Claro בהגדרות היישומים של Android. ההעדפות המקומיות והטיוטות של Claro יימחקו; אנשי הקשר, הודעות ה-SMS והתמונות בטלפון יישמרו.</string>

    <string name="onb_open_contacts_and_speed_dial">פתיחת אנשי קשר וחיוג מהיר</string>
    <string name="onb_people_setup_body">בחרו מה יופיע במסך הבית — אנשי קשר, אפליקציות, SOS, שעון מעורר ועוד (עד 12 אריחים) — ולפי הצורך גם מקשים 1 ו-2 ללחיצה ארוכה. הכול כאן אופציונלי.</string>
    <string name="onb_speed_dial_assigned">משויך</string>
    <string name="onb_speed_dial_not_set">לא הוגדר</string>
    <string name="onb_people_setup_status_configured">%1$d מתוך 12 אריחים במסך הבית הוגדרו. לחיצה ארוכה על 1: %2$s · לחיצה ארוכה על 2: %3$s.</string>
    <string name="onb_people_setup_hold_note">לחיצה ארוכה על 1 או 2 מוציאה שיחה מיד, ללא מסך אישור נוסף.</string>

    <string name="onb_configure_trusted_person">הגדרת איש קשר מהימן</string>
    <string name="onb_continue_sos_incomplete">המשך ללא השלמת SOS</string>
    <string name="onb_sos_setup_body">לחצן SOS מתקשר לאיש קשר מהימן אחד לאחר ספירה לאחור של 5 שניות. זה אינו מוקד מצוקה או שירות חירום, ולא נשלחים בו SMS או מיקום.</string>
    <string name="onb_sos_setup_agreed_info">איש הקשר המהימן נשמר בהסכמתו. מומלץ לבצע שיחת בדיקה מתואמת בנפרד.</string>
    <string name="onb_sos_setup_unconfigured_warning">לחצן SOS אינו מוגדר. לא ניתן להתחיל שיחת SOS עד שאיש קשר אמיתי יאשר זאת.</string>

    <string name="onb_continue_to_handover">המשך לבדיקת המסירה</string>
    <string name="onb_readiness_checklist_info">כל הרשאה או ברירת מחדל ב-Android מתבקשת בנפרד. אם חסרה גישה, הפעולות הרגילות של המכשיר יישארו זמינות.</string>
    <string name="onb_back_to_settings">חזרה להגדרות</string>
    <string name="onb_readiness_settings_info">הסימון מאושר מציין ש-Android העניקה הרשאה — אך אינו מוודא ששיחה, הודעת SMS או בדיקת SOS אכן הצליחו בפועל.</string>

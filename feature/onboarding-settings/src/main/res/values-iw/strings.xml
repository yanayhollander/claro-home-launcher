    <string name="onb_caregiver_pin_option_title">קוד PIN למלווה</string>
    <string name="onb_caregiver_pin_option_subtitle">קוד בן 6 ספרות + צופן שחזור של 12 תווים לפחות</string>
    <string name="onb_date_question_info">כל מי שיודע מה התאריך של היום (dd/MM/YYYY) יכול לפתוח את ההגדרות. אין צורך לשמור קוד PIN או צופן שחזור.</string>
    <string name="onb_caregiver_pin_warning">שמרו במקום בטוח את קוד ה-PIN בן 6 הספרות ואת צופן השחזור (12 תווים לפחות). התאריך של היום אינו פותח ואינו משחזר מצב קוד PIN.</string>

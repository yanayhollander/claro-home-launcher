#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
    cat <<'EOF'
Usage:
  scripts/android-local jvm [<:module> <class-or-method-pattern>]
  scripts/android-local lint
  scripts/android-local ui [--device <serial>] [--class <class[#method]>]
  scripts/android-local all [--device <serial>]
  scripts/android-local internal [--device <serial>]
  scripts/android-local bundle

Device commands require --device or ANDROID_SERIAL for a designated test device.
internal runs the full suite before signing; bundle builds and signs without
running tests or using a device. Both require CLARO_UPLOAD_KEYSTORE outside the
repository and CLARO_UPLOAD_KEY_ALIAS. Passwords are prompted locally, or supply
both CLARO_UPLOAD_STORE_PASSWORD and CLARO_UPLOAD_KEY_PASSWORD through a secure
environment. CLARO_VERSION_CODE and CLARO_VERSION_NAME must explicitly select
the build version after inspecting live Play state. Both commands require
complete production telemetry configuration. Neither uploads or publishes.
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

mode=${1:-}
case "$mode" in
    -h|--help) usage; exit 0 ;;
    jvm|lint|ui|all|internal|bundle) shift ;;
    *) usage >&2; exit 2 ;;
esac

device=${ANDROID_SERIAL:-}
test_class=
check_device() {
    [[ -n "$device" && "$device" != *","* && "$device" != *[[:space:]]* ]] ||
        fail "Select one designated test device with --device or ANDROID_SERIAL."
    local sdk=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
    local adb=adb
    if [[ -n "$sdk" && -x "$sdk/platform-tools/adb" ]]; then
        adb="$sdk/platform-tools/adb"
    fi
    command -v "$adb" >/dev/null || fail "Add Android SDK platform-tools to PATH or set ANDROID_HOME."
    local state boot api
    state=$("$adb" -s "$device" get-state) && [[ "$state" == device ]] ||
        fail "Test device '$device' is not online and authorized."
    boot=$("$adb" -s "$device" shell getprop sys.boot_completed | tr -d '\r') &&
        [[ "$boot" == 1 ]] || fail "Test device '$device' has not finished booting."
    api=$("$adb" -s "$device" shell getprop ro.build.version.sdk | tr -d '\r') &&
        [[ "$api" =~ ^[0-9]+$ && "$api" -ge 29 ]] ||
        fail "Test device '$device' must run Android 10 (API 29) or newer."
}

run_ui() {
    local args=(-Pclaro.localInstrumentation=true connectedDebugAndroidTest)
    if [[ -n "$test_class" ]]; then
        args+=("-Pandroid.testInstrumentationRunnerArguments.class=$test_class")
    fi
    ANDROID_SERIAL="$device" ./gradlew "${args[@]}"
}

run_all() {
    ./gradlew :app:assembleDebug test lint
    run_ui
}

prepare_bundle() {
    [[ "${CLARO_TELEMETRY_ENVIRONMENT:-production}" == production ]] ||
        fail "Play candidates require production telemetry; use staging only for local-test verification."
    : "${CLARO_VERSION_CODE:?Set CLARO_VERSION_CODE after inspecting live Play tracks and bundles.}"
    : "${CLARO_VERSION_NAME:?Set CLARO_VERSION_NAME to the approved release version name.}"
    : "${CLARO_UPLOAD_KEYSTORE:?Set CLARO_UPLOAD_KEYSTORE to the Play upload keystore path.}"
    : "${CLARO_UPLOAD_KEY_ALIAS:?Set CLARO_UPLOAD_KEY_ALIAS to the Play upload key alias.}"
    [[ -f "$CLARO_UPLOAD_KEYSTORE" && -r "$CLARO_UPLOAD_KEYSTORE" ]] ||
        fail "The Play upload keystore is not a readable file."
    local keystore_directory repository_directory session_directory
    keystore_directory=$(cd "$(dirname "$CLARO_UPLOAD_KEYSTORE")" && pwd -P)
    repository_directory=$(pwd -P)
    session_directory="$HOME/.copilot/session-state"
    case "$keystore_directory/" in
        "$repository_directory/"*|"$session_directory/"*)
            fail "Keep the Play upload keystore outside the repository and Copilot session storage."
            ;;
    esac
    [[ ! -L "$CLARO_UPLOAD_KEYSTORE" ]] ||
        fail "Use the upload keystore's actual private path, not a symbolic link."
    if [[ -n "${CLARO_UPLOAD_STORE_PASSWORD:-}" || -n "${CLARO_UPLOAD_KEY_PASSWORD:-}" ]]; then
        [[ -n "${CLARO_UPLOAD_STORE_PASSWORD:-}" && -n "${CLARO_UPLOAD_KEY_PASSWORD:-}" ]] ||
            fail "Provide both upload passwords through the environment, or neither for local prompts."
    fi
    local jarsigner=jarsigner
    if [[ -n "${JAVA_HOME:-}" ]]; then
        jarsigner="$JAVA_HOME/bin/jarsigner"
    fi
    command -v "$jarsigner" >/dev/null || fail "Use a JDK with jarsigner."

    local gradle_args=(-Pclaro.telemetryEnvironment=production -Pclaro.requireTelemetry=true :app:bundleRelease)
    if [[ -n "${CLARO_VERSION_CODE:-}" ]]; then
        [[ "$CLARO_VERSION_CODE" =~ ^[0-9]+$ ]] ||
            fail "CLARO_VERSION_CODE must be an integer."
        gradle_args+=("-Pclaro.versionCode=$CLARO_VERSION_CODE")
    fi
    if [[ -n "${CLARO_VERSION_NAME:-}" ]]; then
        gradle_args+=("-Pclaro.versionName=$CLARO_VERSION_NAME")
    fi
    if [[ "$mode" == internal ]]; then
        run_all
    fi
    ./gradlew "${gradle_args[@]}"

    local unsigned=app/build/outputs/bundle/release/app-release.aab
    [[ -f "$unsigned" ]] || fail "Gradle did not produce the release bundle at $unsigned."
    local result_root=app/build/outputs/internal-testing
    mkdir -p "$result_root"
    local candidate
    candidate=$(mktemp -d "$result_root/candidate.XXXXXXXX")
    local bundle="$candidate/claro-internal.aab"
    local signing_args=(-keystore "$CLARO_UPLOAD_KEYSTORE" -signedjar "$bundle")
    if [[ -n "${CLARO_UPLOAD_STORE_PASSWORD:-}" ]]; then
        signing_args+=(-storepass:env CLARO_UPLOAD_STORE_PASSWORD -keypass:env CLARO_UPLOAD_KEY_PASSWORD)
    fi
    if ! "$jarsigner" "${signing_args[@]}" "$unsigned" "$CLARO_UPLOAD_KEY_ALIAS" ||
        ! "$jarsigner" -verify "$bundle"; then
        rm -f -- "$bundle"
        rmdir -- "$candidate"
        fail "Signing or signature verification failed; do not upload this build."
    fi
    printf '\nSigned candidate for local Android Publisher REST Internal Testing upload:\n%s/%s\n' "$PWD" "$bundle"
    printf 'Verify the registered upload certificate, package and version before uploading. Nothing was published.\n'
}

case "$mode" in
    jvm)
        if [[ $# -eq 0 ]]; then
            exec ./gradlew test
        fi
        [[ $# -eq 2 && "$1" =~ ^(:[a-zA-Z0-9_-]+)+$ && -n "$2" ]] ||
            fail "Use jvm with no arguments, or provide both <:module> and <class-or-method-pattern>."
        exec ./gradlew "$1:testDebugUnitTest" --tests "$2"
        ;;
    lint)
        [[ $# -eq 0 ]] || fail "lint does not accept additional arguments."
        exec ./gradlew lint
        ;;
    bundle)
        [[ $# -eq 0 ]] || fail "bundle does not accept additional arguments."
        prepare_bundle
        ;;
    ui|all|internal)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --device)
                    [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail "Provide a serial after --device."
                    device=$2
                    ;;
                --class)
                    [[ "$mode" == ui && $# -ge 2 && -n "$2" && "$2" != --* ]] ||
                        fail "--class requires a class or class#method and is only supported for ui."
                    test_class=$2
                    ;;
                *) fail "Unknown argument: $1" ;;
            esac
            shift 2
        done
        check_device
        case "$mode" in
            ui) run_ui ;;
            all) run_all ;;
            internal) prepare_bundle ;;
        esac
        ;;
esac
